# Copy to .env for local development. Never commit .env.
KHATAIQ_DATABASE_URL=postgresql+psycopg://khataiq_app:khataiq_app@localhost:5432/khataiq
KHATAIQ_MIGRATION_DATABASE_URL=postgresql+psycopg://khataiq:khataiq@localhost:5432/khataiq
KHATAIQ_APP_DB_PASSWORD=khataiq_app
KHATAIQ_REDIS_URL=redis://localhost:6379/0
KHATAIQ_S3_ENDPOINT=http://localhost:9000
KHATAIQ_S3_ACCESS_KEY=khataiq
KHATAIQ_S3_SECRET_KEY=khataiq-dev-secret
KHATAIQ_S3_BUCKET=statements

# Copilot (optional). Without a key, POST /copilot answers 503.
KHATAIQ_LLM_API_KEY=
KHATAIQ_LLM_MODEL=claude-opus-5-5
